# JulleyOnline Environment Configuration Template
PORT=5000
NODE_ENV=development

# PostgreSQL Connection String (format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/julleyonline_kanban?schema=public"

# JWT Secret Key (minimum 16 characters)
JWT_SECRET="replace_with_a_secure_random_secret_at_least_16_chars"

# Allowed CORS Origin for Frontend Single Page Application
CORS_ORIGIN="http://localhost:5173"
