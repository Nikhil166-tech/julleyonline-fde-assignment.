# JulleyOnline AI Kanban Assistant Microservice Configuration

# Operating mode: 'auto' (Tier 1 Gemini -> Tier 2 Ollama -> Tier 3 Local), 'local', or 'llm'
AI_RESPONSE_MODE=auto

# Force mock/deterministic mode for testing (when true, forces local mode)
MOCK_LLM=false

# Shared service token for Express-to-FastAPI authentication (must be >= 16 chars in production)
AI_SERVICE_TOKEN=dev-ai-service-token-secret

# Google Gemini API key (Tier 1 primary LLM; if omitted, cascades to Tier 2 Ollama)
GEMINI_API_KEY=

# Gemini model selection
AI_MODEL=gemini-3.5-flash
FALLBACK_MODEL=gemini-3.8-flash

# Ollama Cloud configuration (Tier 2 secondary LLM)
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/api
OLLAMA_MODEL=gemma4:31b

# Server binding (defaults to loopback for security)
HOST=127.0.0.1
PORT=8000
