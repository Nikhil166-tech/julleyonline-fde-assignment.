# JulleyOnline AI Kanban Assistant Microservice Configuration

# Shared service token for Express-to-FastAPI authentication
AI_SERVICE_TOKEN=dev-ai-service-token-secret

# Google Gemini API key (optional; if omitted, deterministic fallback engine is used)
GEMINI_API_KEY=

# Model selection
AI_MODEL=gemini-2.5-flash

# Force mock/deterministic mode for testing
MOCK_LLM=false

# Server binding
HOST=0.0.0.0
PORT=8000
